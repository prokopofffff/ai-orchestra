      "position": [750, 250]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://orchestra-core:3000/api/signal/dispatch",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"role\": \"qa\",\n  \"projectId\": \"{{ $json.context.project_id }}\",\n  \"taskId\": \"{{ $json.context.task_id }}\",\n  \"prompt\": \"Новый сигнал от {{ $json.from }}.\\nAction: {{ $json.action }}\\nСообщение: {{ $json.context.message }}\",\n  \"workingDir\": \"/projects/{{ $json.context.project_id }}\"\n}",
        "options": {}
      },
      "id": "dispatch-qa",
      "name": "Dispatch: QA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://orchestra-core:3000/api/signal/dispatch",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"role\": \"devops\",\n  \"projectId\": \"{{ $json.context.project_id }}\",\n  \"taskId\": \"{{ $json.context.task_id }}\",\n  \"prompt\": \"Новый сигнал от {{ $json.from }}.\\nAction: {{ $json.action }}\\nСообщение: {{ $json.context.message }}\",\n  \"workingDir\": \"/projects/{{ $json.context.project_id }}\"\n}",
        "options": {}
      },
      "id": "dispatch-devops",
      "name": "Dispatch: DevOps",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 550]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://openclaw:3100/api/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"telegram\",\n  \"message\": \"[{{ $json.from }}] {{ $json.action }}: {{ $json.context.message }}\"\n}",
        "options": {
          "ignore_ssl_issues": true
        }
      },
      "id": "notify-user-telegram",
      "name": "Notify User (Telegram)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 700]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://orchestra-core:3000/api/signal",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"n8n\",\n  \"to\": \"user\",\n  \"action\": \"mirror\",\n  \"context\": {\n    \"message\": \"[{{ $json.from }} → {{ $json.to }}] {{ $json.action }}: {{ $json.context.message }}\"\n  }\n}",
        "options": {}
      },
      "id": "mirror-to-telegram",
      "name": "Mirror to Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'routed', to: $('Webhook: Signal').item.json.to, action: $('Webhook: Signal').item.json.action }) }}",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1250, 300]
    }
  ],
