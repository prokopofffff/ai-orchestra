{
  "name": "Telegram → Tech Lead",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-telegram",
      "name": "Webhook: Telegram Update",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse Telegram Bot API update payload\nconst body = $input.first().json.body || $input.first().json;\nconst msg = body.message || body.edited_message;\n\nif (!msg || !msg.text) {\n  return [{ json: { skip: true } }];\n}\n\nreturn [{\n  json: {\n    chatId: String(msg.chat.id),\n    username: msg.from?.username || msg.from?.first_name || 'user',\n    text: msg.text,\n    messageId: msg.message_id,\n    timestamp: new Date(msg.date * 1000).toISOString()\n  }\n}];"
      },
      "id": "parse-telegram",
      "name": "Parse Telegram Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "notEquals" }
            }
          ]
        }
      },
      "id": "if-has-text",
      "name": "Has Text?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://orchestra-core:3000/api/signal/dispatch",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"role\": \"tech-lead\",\n  \"projectId\": \"default\",\n  \"prompt\": \"Сообщение от пользователя {{ $json.username }} (chat_id: {{ $json.chatId }}) через Telegram:\\n\\n{{ $json.text }}\\n\\nОтветь пользователю через notify_user().\"\n}",
        "options": {}
      },
      "id": "dispatch-tech-lead",
      "name": "Dispatch Tech Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 250]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": true}",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1180, 300]
    }
  ],
  "connections": {
    "Webhook: Telegram Update": {
      "main": [
        [{ "node": "Parse Telegram Message", "type": "main", "index": 0 }]
      ]
    },
    "Parse Telegram Message": {
      "main": [
        [{ "node": "Has Text?", "type": "main", "index": 0 }]
      ]
    },
    "Has Text?": {
      "main": [
        [{ "node": "Dispatch Tech Lead", "type": "main", "index": 0 }],
        [{ "node": "Respond OK", "type": "main", "index": 0 }]
      ]
    },
    "Dispatch Tech Lead": {
      "main": [
        [{ "node": "Respond OK", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [{ "name": "orchestra" }]
}
