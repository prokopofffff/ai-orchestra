{
  "name": "orchestra-core",
  "version": "0.1.0",
  "description": "AI Orchestra — core orchestrator service",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "setup": "tsx src/setup-wizard.ts",
    "pretest": "tsx src/ensure-test-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:introspect": "drizzle-kit introspect"
  },
  "dependencies": {
    "@ai-orchestra/shared": "workspace:*",
    "@clack/prompts": "^0.10.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/http-proxy": "^11.4.4",
    "@fastify/jwt": "^9.0.4",
    "@fastify/static": "^9.1.1",
    "cron-parser": "^5.5.0",
    "dockerode": "^5.0.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "graphile-worker": "^0.16.6",
    "minimatch": "^10.2.5",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "simple-git": "^3.36.0",
    "tar": "^7.5.15",
    "tsx": "^4.19.0",
    "uuid": "^10.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.6.0",
    "vitest": "^3.2.1"
  }
}
