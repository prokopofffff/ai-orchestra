        "options": {}
      },
      "id": "dispatch-designer",
      "name": "Dispatch: Designer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 175]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://orchestra-core:3000/api/signal/dispatch",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"role\": \"{{ $json.to }}\",\n  \"projectId\": \"{{ $json.context.project_id }}\",\n  \"taskId\": \"{{ $json.context.task_id }}\",\n  \"prompt\": \"Новый сигнал от {{ $json.from }}.\\nAction: {{ $json.action }}\\nСообщение: {{ $json.context.message }}\",\n  \"workingDir\": \"/projects/{{ $json.context.project_id }}\"\n}",
        "options": {}
      },
