# Required
CLAUDE_AUTH=max                    # "max" | "api"
CLAUDE_API_KEY=                    # only if auth=api

# Optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GITHUB_TOKEN=
GITHUB_DEFAULT_ORG=
GITHUB_DEFAULT_BRANCH=main

# Pencil CLI (run `pencil login` first, or set PENCIL_CLI_KEY for CI/CD)
# Uses Pencil's own backend — does NOT consume Claude API/Max quota
PENCIL_CLI_KEY=                    # optional, for CI/CD only
PENCIL_MODEL=claude-sonnet-4-6    # model for pencil design generation

# Agent models (opus | sonnet | haiku)
MODEL_TECH_LEAD=opus
MODEL_DESIGNER=sonnet
MODEL_FRONTEND=sonnet
MODEL_BACKEND=sonnet
MODEL_QA=sonnet
MODEL_DEVOPS=sonnet

# Auto-generated by setup wizard
POSTGRES_PASSWORD=
SESSION_SECRET=
