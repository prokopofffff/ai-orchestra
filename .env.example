# ─── Required ─────────────────────────────────────────────────────────
DATABASE_URL=postgres://orchestra:orchestra_secret@127.0.0.1:5434/orchestra

# ─── Claude authentication ───────────────────────────────────────────
# "max" for subscription, "api" for API key. The API key itself lives
# in system_config (set via the System settings tab), not in this file.
CLAUDE_AUTH=max

# ─── Optional ─────────────────────────────────────────────────────────
GITHUB_DEFAULT_ORG=
GITHUB_DEFAULT_BRANCH=main

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# First project (auto-created on first boot if set)
FIRST_PROJECT_NAME=
FIRST_PROJECT_REPO=

# Pencil design tool
PENCIL_ENABLED=false
PENCIL_CLI_KEY=                    # for CI/CD; desktop app uses own auth
PENCIL_MODEL=claude-sonnet-4-6

# Agent models (opus | sonnet | haiku)
MODEL_TECH_LEAD=opus
MODEL_DESIGNER=sonnet
MODEL_FRONTEND=sonnet
MODEL_BACKEND=sonnet
MODEL_QA=sonnet
MODEL_DEVOPS=sonnet

# Observability
LOG_LEVEL=info                     # debug | info | warn | error

# Auto-generated by setup wizard
POSTGRES_PASSWORD=
