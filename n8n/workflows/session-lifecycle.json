{
  "name": "Session Lifecycle Manager",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://orchestra-core:3000/api/sessions",
        "options": {}
      },
      "id": "get-sessions",
      "name": "Get All Sessions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "const sessions = $input.first().json;\nconst now = Date.now();\nconst TIMEOUT_MS = 8 * 60 * 60 * 1000; // 8 hours\n\nconst stale = [];\nconst active = [];\n\nif (Array.isArray(sessions)) {\n  for (const s of sessions) {\n    if (s.status === 'terminated') continue;\n    \n    const age = now - new Date(s.lastActiveAt).getTime();\n    if (age > TIMEOUT_MS) {\n      stale.push(s);\n    } else if (s.status === 'running' || s.status === 'sleeping') {\n      active.push(s);\n    }\n  }\n}\n\nreturn [\n  {\n    json: {\n      stale_count: stale.length,\n      active_count: active.length,\n      stale_sessions: stale.map(s => s.id),\n      timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
      "id": "check-stale",
      "name": "Find Stale Sessions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{ $json.stale_count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        }
      },
      "id": "if-has-stale",
      "name": "Has Stale Sessions?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "jsCode": "const staleIds = $input.first().json.stale_sessions;\nreturn staleIds.map(id => ({ json: { sessionId: id } }));"
      },
      "id": "split-stale",
      "name": "Split Session IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=http://orchestra-core:3000/api/sessions/{{ $json.sessionId }}",
        "options": {}
      },
      "id": "terminate-session",
      "name": "Terminate Session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 200]
    },
    {
      "parameters": {
        "url": "http://orchestra-core:3000/api/signal/pending/tech-lead",
        "options": {}
      },
      "id": "check-queue",
      "name": "Check Signal Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{ Array.isArray($json) ? $json.length : 0 }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        }
      },
      "id": "if-has-queued",
      "name": "Has Queued Signals?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1440, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://orchestra-core:3000/api/signal/dispatch",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"role\": \"tech-lead\",\n  \"projectId\": \"default\",\n  \"prompt\": \"У тебя есть непрочитанные сигналы. Проверь очередь и обработай их.\"\n}",
        "options": {}
      },
      "id": "process-queue",
      "name": "Dispatch Tech Lead for Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 350]
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [{ "node": "Get All Sessions", "type": "main", "index": 0 }]
      ]
    },
    "Get All Sessions": {
      "main": [
        [{ "node": "Find Stale Sessions", "type": "main", "index": 0 }]
      ]
    },
    "Find Stale Sessions": {
      "main": [
        [{ "node": "Has Stale Sessions?", "type": "main", "index": 0 }]
      ]
    },
    "Has Stale Sessions?": {
      "main": [
        [{ "node": "Split Session IDs", "type": "main", "index": 0 }],
        [{ "node": "Check Signal Queue", "type": "main", "index": 0 }]
      ]
    },
    "Split Session IDs": {
      "main": [
        [{ "node": "Terminate Session", "type": "main", "index": 0 }]
      ]
    },
    "Terminate Session": {
      "main": [
        [{ "node": "Check Signal Queue", "type": "main", "index": 0 }]
      ]
    },
    "Check Signal Queue": {
      "main": [
        [{ "node": "Has Queued Signals?", "type": "main", "index": 0 }]
      ]
    },
    "Has Queued Signals?": {
      "main": [
        [{ "node": "Dispatch Tech Lead for Queue", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [{ "name": "orchestra" }]
}
