# ─── Required ─────────────────────────────────────────────────────────
DATABASE_URL=postgres://orchestra:orchestra_secret@127.0.0.1:5434/orchestra

# AES-256 key (base64, 32 bytes) for encrypting per-project secrets
# (git PATs, etc.) at rest. Multi-tenant deployments REQUIRE this —
# without it, a DB-level snoop could read any tenant's tokens.
# Generate with: openssl rand -base64 32
ORCHESTRA_SECRETS_KEY=

# Root directory for per-user project workspaces. Each user's projects
# live under <root>/<userId>/. In docker this maps to a named volume so
# repos survive container rebuilds; on a dev laptop you can leave it
# unset (defaults to $HOME/orchestra-workspaces).
ORCHESTRA_WORKSPACES_ROOT=

# ─── Claude authentication ───────────────────────────────────────────
# "max" for subscription, "api" for API key. The API key itself is
# configured per-project in Settings, not in this file.
CLAUDE_AUTH=max

# ─── One-button git connect (GitHub App / GitLab OAuth) ──────────────
# Each deployment registers its OWN GitHub App / GitLab OAuth app. The
# PRIMARY way to do this is in-app: the instance admin opens Profile →
# "Интеграция Git" and clicks "Create GitHub App" (a 2-click manifest flow
# that stores the credentials in the DB automatically) and/or pastes GitLab
# OAuth client id/secret. The env vars below are only a fallback/bootstrap
# for ops who'd rather bake config in — DB-stored config wins over env.
#
# Public, browser-reachable origin of this deployment (no trailing slash).
# REQUIRED for OAuth redirects — providers redirect to
# ${ORCHESTRA_PUBLIC_URL}/api/git/<provider>/callback. Behind a proxy this
# must be set; otherwise orchestra infers it from the request host.
ORCHESTRA_PUBLIC_URL=

# ── Optional env fallback (in-app admin setup is preferred) ──
# GitHub App — set these only to pre-provision without the manifest flow.
GITHUB_APP_ID=
GITHUB_APP_SLUG=                    # the github.com/apps/<slug> segment
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=             # PEM; \n-escaped on one line, or base64
GITHUB_APP_WEBHOOK_SECRET=         # optional

# GitLab OAuth application (redirect ${ORCHESTRA_PUBLIC_URL}/api/git/gitlab/callback, scope api).
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_BASE_URL=https://gitlab.com   # self-hosted: your instance origin

# ─── Optional ─────────────────────────────────────────────────────────
GITHUB_DEFAULT_ORG=
GITHUB_DEFAULT_BRANCH=main

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# First project (auto-created on first boot if set)
FIRST_PROJECT_NAME=
FIRST_PROJECT_REPO=

# Pencil design tool
PENCIL_ENABLED=false
PENCIL_CLI_KEY=                    # for CI/CD; desktop app uses own auth
PENCIL_MODEL=claude-sonnet-4-6

# Agent models (opus | sonnet | haiku)
MODEL_TECH_LEAD=opus
MODEL_DESIGNER=sonnet
MODEL_FRONTEND=sonnet
MODEL_BACKEND=sonnet
MODEL_QA=sonnet
MODEL_DEVOPS=sonnet

# Observability
LOG_LEVEL=info                     # debug | info | warn | error

# Auto-generated by setup wizard
POSTGRES_PASSWORD=
